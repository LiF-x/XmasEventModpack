{
  "schemaVersion": 1,
  "id": "XmasEventModpack",
  "name": "Xmas Event Modpack",
  "version": "1.0.0",
  "description": "Christmas event modpack: spawns 150 Christmas gifts hourly with a 10-minute event window. Bundles Events, Loot (knool-style), and the auto-spawn/cleanup XmasMod.",
  "authors": [
    "lif-x community"
  ],
  "loadOrderHint": 100,
  "files": {
    "overlay": [
      {
        "src": "mods/",
        "dest": "mods/"
      },
      {
        "src": "yolauncher/modpack/mods/LiFx/",
        "dest": "yolauncher/modpack/mods/LiFx/"
      }
    ],
    "dataPatches": [
      {
        "target": "data/cm_objects.xml",
        "replace": "data/cm_objects.xml"
      }
    ]
  }
}